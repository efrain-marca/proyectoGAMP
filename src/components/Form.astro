---
import { randomUUID } from 'node:crypto';
const {action,project,back='/app',fields=[],label='Guardar',style='primary',extra={},upload=false}=Astro.props;
---
<form method="post" action="/api/interno/operacion" class="operation" data-async enctype={upload?'multipart/form-data':undefined}>
  <input type="hidden" name="accion" value={action} />
  <input type="hidden" name="operacion" value={randomUUID()} />
  <input type="hidden" name="volver" value={back} />
  {project&&<input type="hidden" name="proyecto" value={project} />}
  {Object.entries(extra).filter(([,value])=>value!==null&&value!==undefined&&value!=='NULL').map(([name,value])=><input type="hidden" name={name} value={String(value)} />)}
  <div class="fields">
    {fields.map(field=>field.type==='multi' ? (
      <fieldset class="wide checklist"><legend>{field.label}</legend>
        <div>{field.options?.length? field.options.map(opt=><label class="check"><input type="checkbox" name={field.name} value={opt.value} checked={opt.checked} /><span>{opt.label}</span></label>):<small>Sin opciones disponibles.</small>}</div>
      </fieldset>
    ) : field.type==='checkbox' ? (
      <label class="check wide"><input type="checkbox" name={field.name} value="1" checked={Boolean(field.value)} required={field.required} /><span>{field.label}</span></label>
    ) : (
      <label class:list={[field.wide&&'wide']}>{field.label}
        {field.type==='select'?<select name={field.name} required={field.required!==false}><option value="">{field.placeholder||'Seleccionar'}</option>{field.options?.map(opt=><option value={opt.value} selected={String(field.value)===String(opt.value)}>{opt.label}</option>)}</select>:
          field.type==='textarea'?<textarea name={field.name} required={field.required!==false} minlength={field.minLength} maxlength={field.maxLength} rows="3">{field.value??''}</textarea>:
          <input name={field.name} type={field.type||'text'} value={field.type==='file'?'':field.value} required={field.required!==false} pattern={field.pattern} title={field.help} placeholder={field.placeholder} min={field.min} max={field.max} minlength={field.minLength} maxlength={field.maxLength} step={field.step} accept={field.accept} autocomplete={field.type==='password'?'new-password':undefined} />}
        {field.help&&<small>{field.help}</small>}
      </label>
    ))}
  </div>
  <slot />
  <p class="notice error" role="alert" tabindex="-1" hidden></p>
  <button type="submit" class:list={['button',style]}>{label}</button>
</form>
